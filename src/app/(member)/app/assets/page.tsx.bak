// PURPOSE:
// - Member app assets placeholder UI.
//
// CHANGES (v1.1):
// - FIX: Convert Assets page to light SaaS styling (readable dark text).
// - UX: Improve placeholder to feel more production-ready (folder cards, actions, storage bar).
// - Preserve "floating card" feel with soft shadows.
// - No backend wiring added (still placeholder only).
//
// VERSION HISTORY:
// - v1.0: Initial placeholder UI.
// - v1.1 (2026-03-01): Light theme + improved layout/UX.

const folders = [
  { name: 'Site photos', note: 'Photos taken on site', files: 0 },
  { name: 'Quote attachments', note: 'Drawings, specs, references', files: 0 },
  { name: 'Invoices', note: 'Generated PDFs & statements', files: 0 },
  { name: 'Certificates', note: 'Compliance and certificates', files: 0 },
];

function FolderIcon() {
  return (
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path
        d="M3.5 7.5c0-1.1.9-2 2-2h4.2c.6 0 1.2.2 1.6.7l1.1 1.1c.3.3.7.5 1.1.5H18.5c1.1 0 2 .9 2 2v7.8c0 1.1-.9 2-2 2h-13c-1.1 0-2-.9-2-2V7.5Z"
        stroke="currentColor"
        strokeWidth="1.8"
        strokeLinejoin="round"
      />
    </svg>
  );
}

export default function AppAssetsPage() {
  const usedMb = 0;
  const totalMb = 1024;
  const usedPct = Math.max(0, Math.min(100, (usedMb / totalMb) * 100));

  return (
    <div className="grid gap-6 lg:grid-cols-3">
      {/* Main */}
      <section className="lg:col-span-2 rounded-2xl border border-gray-200 bg-white p-5 shadow-[0_18px_50px_-35px_rgba(0,0,0,0.28)]">
        <div className="flex flex-wrap items-start justify-between gap-3">
          <div>
            <h2 className="text-lg font-semibold text-slate-900">Asset library</h2>
            <p className="mt-1 text-sm text-slate-600">
              Store site photos, documents, and certificates in one place.
            </p>
          </div>

          <button
            type="button"
            disabled
            title="Coming soon"
            className="cursor-not-allowed rounded-full border border-gray-200 bg-white px-4 py-2 text-sm font-semibold text-slate-400 opacity-80"
          >
            Upload (Coming soon)
          </button>
        </div>

        <div className="mt-5 grid gap-3 sm:grid-cols-2">
          {folders.map((folder) => (
            <article
              key={folder.name}
              className="rounded-2xl border border-gray-200 bg-white px-4 py-4 shadow-[0_16px_40px_-34px_rgba(0,0,0,0.22)]"
            >
              <div className="flex items-start justify-between gap-3">
                <div className="flex items-start gap-3">
                  <div className="mt-0.5 inline-flex h-9 w-9 items-center justify-center rounded-xl border border-gray-200 bg-gray-50 text-slate-700">
                    <FolderIcon />
                  </div>

                  <div className="min-w-0">
                    <p className="font-semibold text-slate-900">{folder.name}</p>
                    <p className="mt-0.5 text-xs text-slate-500">{folder.note}</p>
                  </div>
                </div>

                <span className="shrink-0 rounded-full border border-gray-200 bg-gray-50 px-2.5 py-1 text-xs font-semibold text-slate-700">
                  {folder.files} files
                </span>
              </div>

              <div className="mt-4 flex items-center justify-between gap-2">
                <button
                  type="button"
                  disabled
                  title="Coming soon"
                  className="cursor-not-allowed rounded-full border border-gray-200 bg-white px-3 py-1.5 text-xs font-semibold text-slate-400 opacity-80"
                >
                  View
                </button>

                <button
                  type="button"
                  disabled
                  title="Coming soon"
                  className="cursor-not-allowed rounded-full border border-gray-200 bg-white px-3 py-1.5 text-xs font-semibold text-slate-400 opacity-80"
                >
                  Add files
                </button>
              </div>
            </article>
          ))}
        </div>
      </section>

      {/* Sidebar */}
      <aside className="rounded-2xl border border-gray-200 bg-white p-5 shadow-[0_18px_50px_-35px_rgba(0,0,0,0.28)]">
        <h3 className="text-base font-semibold text-slate-900">Storage</h3>
        <p className="mt-2 text-sm text-slate-600">
          Used: <span className="font-semibold text-slate-900">{usedMb} MB</span> of{' '}
          <span className="font-semibold text-slate-900">1 GB</span>
        </p>

        <div className="mt-4">
          <div className="h-2 w-full overflow-hidden rounded-full border border-gray-200 bg-gray-50">
            <div className="h-full rounded-full bg-slate-900/20" style={{ width: `${usedPct}%` }} />
          </div>
          <p className="mt-2 text-xs text-slate-500">
            Upload limits and file organisation will be enabled in a later stage.
          </p>
        </div>

        <div className="mt-5 rounded-2xl border border-amber-200/60 bg-amber-50 p-4">
          <p className="text-sm font-semibold text-slate-900">Tip</p>
          <p className="mt-1 text-sm text-slate-700">
            Keep certificates and site photos organised per job so you can attach them to quotes and
            invoices quickly.
          </p>
        </div>
      </aside>
    </div>
  );
}