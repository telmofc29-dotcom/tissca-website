// src/app/(member)/app/invoices/page.tsx v1.1
//
// PURPOSE:
// - Member app invoices placeholder UI.
//
// CHANGES (v1.1):
// - FIX: Convert invoices page to light SaaS styling (readable dark text).
// - UX: Add summary row + clearer hierarchy (ref/client, amount/due, status badge).
// - Preserve "floating card" feel with soft shadows.
// - Keep placeholder-only behaviour (no backend wiring).
//
// VERSION HISTORY:
// - v1.0: Initial placeholder UI (dark/glass).
// - v1.1 (2026-03-01): Light theme + improved layout/UX.

const invoices = [
  { ref: 'INV-0001', client: 'Client placeholder', due: 'No due date', amount: '£0', status: 'Draft' },
  { ref: 'INV-0002', client: 'Client placeholder', due: 'No due date', amount: '£0', status: 'Draft' },
];

function statusBadgeClasses(status: string) {
  const raw = String(status || '').toLowerCase().trim();

  if (raw === 'paid') return 'border-emerald-200 bg-emerald-50 text-emerald-700';
  if (raw === 'overdue') return 'border-red-200 bg-red-50 text-red-700';
  if (raw === 'sent') return 'border-blue-200 bg-blue-50 text-blue-700';
  return 'border-gray-200 bg-gray-50 text-slate-700'; // Draft/default
}

export default function AppInvoicesPage() {
  return (
    <div className="space-y-6">
      <section className="rounded-2xl border border-gray-200 bg-white p-5 shadow-[0_18px_50px_-35px_rgba(0,0,0,0.28)]">
        <div className="flex flex-wrap items-start justify-between gap-3">
          <div>
            <h2 className="text-lg font-semibold text-slate-900">Invoice tracker</h2>
            <p className="mt-1 text-sm text-slate-600">
              Track drafts, sent invoices, and overdue payments in one place.
            </p>
          </div>

          <div className="flex items-center gap-2">
            <button
              type="button"
              disabled
              title="Coming soon"
              className="cursor-not-allowed rounded-full border border-gray-200 bg-white px-4 py-2 text-sm font-semibold text-slate-400 opacity-80"
            >
              Export statements
            </button>

            <button
              type="button"
              disabled
              title="Coming soon"
              className="cursor-not-allowed rounded-full border border-gray-200 bg-slate-900 px-4 py-2 text-sm font-semibold text-white/80 opacity-80"
            >
              New invoice
            </button>
          </div>
        </div>

        {/* Summary row */}
        <div className="mt-4 grid gap-3 sm:grid-cols-3">
          <article className="rounded-2xl border border-gray-200 bg-white px-4 py-4 shadow-[0_16px_40px_-34px_rgba(0,0,0,0.22)]">
            <p className="text-sm text-slate-600">Total invoices</p>
            <p className="mt-2 text-2xl font-semibold tracking-tight text-slate-900">{invoices.length}</p>
            <p className="mt-1 text-xs text-slate-500">Placeholder values</p>
          </article>

          <article className="rounded-2xl border border-gray-200 bg-white px-4 py-4 shadow-[0_16px_40px_-34px_rgba(0,0,0,0.22)]">
            <p className="text-sm text-slate-600">Outstanding</p>
            <p className="mt-2 text-2xl font-semibold tracking-tight text-slate-900">£0</p>
            <p className="mt-1 text-xs text-slate-500">No overdue items</p>
          </article>

          <article className="rounded-2xl border border-gray-200 bg-white px-4 py-4 shadow-[0_16px_40px_-34px_rgba(0,0,0,0.22)]">
            <p className="text-sm text-slate-600">Paid this month</p>
            <p className="mt-2 text-2xl font-semibold tracking-tight text-slate-900">£0</p>
            <p className="mt-1 text-xs text-slate-500">Connect payments later</p>
          </article>
        </div>

        {/* List */}
        <div className="mt-5 space-y-3">
          {invoices.map((invoice) => (
            <article
              key={invoice.ref}
              className="rounded-2xl border border-gray-200 bg-white px-4 py-4 shadow-[0_16px_40px_-34px_rgba(0,0,0,0.22)]"
            >
              <div className="flex flex-wrap items-start justify-between gap-3">
                <div className="min-w-0">
                  <div className="flex flex-wrap items-center gap-2">
                    <p className="font-semibold text-slate-900">{invoice.ref}</p>
                    <span
                      className={`inline-flex items-center rounded-full border px-2.5 py-1 text-xs font-semibold ${statusBadgeClasses(
                        invoice.status
                      )}`}
                    >
                      {invoice.status}
                    </span>
                  </div>

                  <p className="mt-1 text-sm text-slate-600">{invoice.client}</p>
                </div>

                <div className="text-right">
                  <p className="text-sm font-semibold text-slate-900">{invoice.amount}</p>
                  <p className="mt-1 text-xs text-slate-600">{invoice.due}</p>
                </div>
              </div>
            </article>
          ))}
        </div>

        <div className="mt-5 rounded-2xl border border-gray-200 bg-gray-50 px-4 py-4">
          <p className="text-sm font-semibold text-slate-900">Next</p>
          <p className="mt-1 text-sm text-slate-600">
            When we wire real invoices, this page will support search, filters (Draft/Sent/Paid/Overdue),
            exporting, and payment reminders.
          </p>
        </div>
      </section>
    </div>
  );
}